              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": 1,\n      \"selectedOptionId\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/1/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "1", "submit"]
            }
          }
        },
        {
          "name": "Consultar Histórico de Simulados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Resultados & Desempenho",
      "item": [
