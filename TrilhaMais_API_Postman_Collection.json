              "raw": "{\n  \"title\": \"Simulado de Revisão — Árvores\",\n  \"topicId\": 1,\n  \"questionCount\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "generate"]
            }
          }
        },
        {
          "name": "Submeter Respostas e Receber Nota",
          "request": {
            "method": "POST",
            "header": [
